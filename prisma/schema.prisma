generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modules fonctionnels de l'application (section 2 & 3 de la spec).
// La matrice de permissions associe chaque rôle à un niveau d'accès par module.
enum Module {
  CAISSE
  COMMANDES
  STOCKS
  PRODUCTION
  FOURNISSEURS
  COMMISSIONS
  PARAMETRES
  EQUIPE
  RAPPORTS
  TRAVAILLEURS
}

enum NiveauAcces {
  AUCUN
  LECTURE
  ECRITURE
}

enum MoyenPaiement {
  ESPECES
  MOBILE_MONEY
  CARTE
}

enum PrioriteNotification {
  NORMALE
  HAUTE
}

// Hiérarchie portée par le rôle (roleParentId) — extensible sans changement de code.
model Role {
  id           String           @id @default(cuid())
  nom          String           @unique
  roleParentId String?
  roleParent   Role?            @relation("HierarchieRoles", fields: [roleParentId], references: [id])
  sousRoles    Role[]           @relation("HierarchieRoles")
  permissions  RolePermission[]
  utilisateurs Utilisateur[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model RolePermission {
  id          String      @id @default(cuid())
  roleId      String
  role        Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module      Module
  niveauAcces NiveauAcces

  @@unique([roleId, module])
}

model Utilisateur {
  id            String   @id @default(cuid())
  nom           String
  email         String   @unique
  motDePasseHash String
  roleId        String
  role          Role     @relation(fields: [roleId], references: [id])
  actif         Boolean  @default(true)
  // Compte Administrateur principal (max 3 comptes admin : 1 principal + 2
  // secondaires). Unicité du principal garantie par un index partiel en SQL
  // (voir migration) ; le workflow d'approbation complet arrive en Phase 10.
  estAdminPrincipal Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  notifications Notification[] @relation("NotificationsRecues")
  notificationsEmises Notification[] @relation("NotificationsEmises")
  commandesCreees CommandeClient[]
  reglementsEnregistres PaiementCommande[]
  ventes        Vente[]
  clotures      ClotureCaisse[]
}

// Notification métier (section 3.10) : persistée pour le rattrapage hors ligne,
// poussée en temps réel via Socket.io aux destinataires déterminés par la
// matrice de permissions + la hiérarchie.
model Notification {
  id             String      @id @default(cuid())
  destinataireId String
  destinataire   Utilisateur @relation("NotificationsRecues", fields: [destinataireId], references: [id], onDelete: Cascade)
  emetteurId     String?
  emetteur       Utilisateur? @relation("NotificationsEmises", fields: [emetteurId], references: [id], onDelete: SetNull)
  type           String
  module         Module
  evenementRef   String?
  message        String
  donnees        Json?
  // HAUTE = alerte visuellement distincte (ex. transaction inhabituelle, 3.10)
  priorite       PrioriteNotification @default(NORMALE)
  lu             Boolean     @default(false)
  dateCreation   DateTime    @default(now())

  @@index([destinataireId, lu])
  @@index([destinataireId, dateCreation])
}

// Types de clients — la « Qualité » dans l'app (section 3.4) — avec
// tarification et commission par bac (montants en Fc).
// Dépositaire (4100, 0), Vente cash (4350, 0), Maman (6000, 1650).
model TypeClient {
  id               String   @id @default(cuid())
  nom              String   @unique
  prixParBac       Int
  commissionParBac Int      @default(0)
  clients          Client[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Le solde d'avance est porté par le client (pas par la commande) et se
// reporte automatiquement d'une commande à l'autre (section 3.4).
model Client {
  id               String           @id @default(cuid())
  nom              String
  telephone        String?
  typeClientId     String
  typeClient       TypeClient       @relation(fields: [typeClientId], references: [id])
  avanceDisponible Int              @default(0)
  pointsFidelite   Int              @default(0)
  commandes        CommandeClient[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

// Commande client (section 3.4). Tous les montants sont figés à
// l'enregistrement (en Fc) ; nouvelleAvance est le solde du client juste
// après cette commande (photographie, pour afficher le champ 11 de la spec).
model CommandeClient {
  id                String      @id @default(cuid())
  numero            Int         @unique @default(autoincrement())
  clientId          String
  client            Client      @relation(fields: [clientId], references: [id])
  quantiteBacs      Int
  montantBrut       Int
  avanceUtilisee    Int
  montantAPercevoir Int
  montantRecu       Int
  dette             Int
  avanceGeneree     Int
  nouvelleAvance    Int
  creeParId         String
  creePar           Utilisateur @relation(fields: [creeParId], references: [id])
  dateCreation      DateTime    @default(now())
  reglements        PaiementCommande[]

  @@index([clientId])
  @@index([dateCreation])
}

// Règlement ultérieur d'une dette de commande (section 3.4) : le montant
// s'ajoute au montant reçu de la commande, dette/avance recalculées avec la
// même logique qu'à l'enregistrement. Journal conservé (montant, date, auteur).
model PaiementCommande {
  id               String         @id @default(cuid())
  commandeClientId String
  commandeClient   CommandeClient @relation(fields: [commandeClientId], references: [id], onDelete: Cascade)
  montant          Int
  date             DateTime       @default(now())
  enregistreParId  String
  enregistrePar    Utilisateur    @relation(fields: [enregistreParId], references: [id])

  @@index([commandeClientId])
}

// Catalogue produits. Montants en Fc. Le pain est exonéré de TVA (tauxTaxe = 0) ;
// le taux reste configurable par produit pour d'éventuels articles hors pain.
model Produit {
  id        String   @id @default(cuid())
  nom       String   @unique
  prixVente Int
  tauxTaxe  Float    @default(0)
  categorie String
  actif     Boolean  @default(true)
  lignesVente LigneVente[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Caisse (section 3.1) ---------------------------------------------------

// Vente au comptoir. Montants en Fc, figés à l'encaissement ; le pain est
// exonéré (tauxTaxe = 0), la taxe éventuelle vient des produits hors pain.
model Vente {
  id            String        @id @default(cuid())
  numero        Int           @unique @default(autoincrement())
  date          DateTime      @default(now())
  vendeurId     String
  vendeur       Utilisateur   @relation(fields: [vendeurId], references: [id])
  total         Int
  totalTaxe     Int           @default(0)
  moyenPaiement MoyenPaiement
  lignes        LigneVente[]
  // Renseigné par la clôture de caisse journalière qui englobe cette vente.
  clotureId     String?
  cloture       ClotureCaisse? @relation(fields: [clotureId], references: [id])

  @@index([date])
  @@index([clotureId])
}

model LigneVente {
  id           String  @id @default(cuid())
  venteId      String
  vente        Vente   @relation(fields: [venteId], references: [id], onDelete: Cascade)
  produitId    String
  produit      Produit @relation(fields: [produitId], references: [id])
  quantite     Int
  prixUnitaire Int
  tauxTaxe     Float
}

// Clôture de caisse journalière : regroupe toutes les ventes non encore
// clôturées et fige les totaux par moyen de paiement.
model ClotureCaisse {
  id               String   @id @default(cuid())
  date             DateTime @default(now())
  caissierId       String
  caissier         Utilisateur @relation(fields: [caissierId], references: [id])
  nombreVentes     Int
  totalVentes      Int
  totalEspeces     Int
  totalMobileMoney Int
  totalCarte       Int
  ventes           Vente[]

  @@index([date])
}

// Paramètres de la boutique (section 3.9) — clé/valeur, édités par l'Admin.
// Ex. : seuil_alerte_transaction = "100000" (Fc, alerte 3.10).
model ParametreBoutique {
  id        String   @id @default(cuid())
  cle       String   @unique
  valeur    String
  updatedAt DateTime @updatedAt
}
