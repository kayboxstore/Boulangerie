DATABASE_URL="postgresql://postgres:lomoto_dev@localhost:5434/boulangerie_lomoto?schema=public"
JWT_SECRET="change-me"
PORT=3001

# Envoi des rapports par email (section 3.13) — Gmail / Google Workspace avec un
# MOT DE PASSE D'APPLICATION (pas le mot de passe du compte).
# À renseigner SÉPARÉMENT en local et sur l'hébergeur : ces valeurs ne se
# propagent pas d'un environnement à l'autre.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
# Surcharges facultatives (tests, autre fournisseur SMTP) :
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_SECURE="true"

# Sauvegarde automatique de la base vers Google Drive (section 3.15) — utilise un
# COMPTE DE SERVICE Google Cloud, distinct du mot de passe d'application Gmail
# ci-dessus. Voir DEPLOIEMENT.md pour la marche à suivre côté Google Cloud.
# À renseigner SÉPARÉMENT en local et sur l'hébergeur.
# La clé JSON du compte de service, sur UNE seule ligne (ou encodée en base64) :
GOOGLE_SERVICE_ACCOUNT_JSON=""
# Identifiant du dossier Drive de destination (le suffixe de son URL), partagé
# en Éditeur avec l'email du compte de service :
GOOGLE_DRIVE_FOLDER_ID=""
# Surcharges facultatives de la planification :
# BACKUP_CRON="30 2 * * *"
# BACKUP_TIMEZONE="Africa/Kinshasa"
# Chemin de pg_dump si l'hôte ne le met pas dans le PATH :
# PG_DUMP_PATH="/usr/bin/pg_dump"
