DATABASE_URL="postgresql://postgres:lomoto_dev@localhost:5434/boulangerie_lomoto?schema=public"
JWT_SECRET="change-me"
PORT=3001
# Nombre exact de proxies de confiance devant Express. Render utilise
# généralement un proxy ; en local la valeur par défaut est 0.
TRUST_PROXY_HOPS="1"

# Envoi des rapports par email (section 3.13) — Gmail / Google Workspace avec un
# MOT DE PASSE D'APPLICATION (pas le mot de passe du compte).
# À renseigner SÉPARÉMENT en local et sur l'hébergeur : ces valeurs ne se
# propagent pas d'un environnement à l'autre.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
# Surcharges facultatives (tests, autre fournisseur SMTP) :
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"
# SMTP_SECURE="true"

# Adresse email professionnelle (section 3.18) — Cloudflare Email Routing.
# Deux portées DIFFÉRENTES sur le jeton API : la création d'une adresse de
# destination est une opération de COMPTE (permission "Email Routing
# Addresses: Edit"), la création de la règle de routage est une opération de
# ZONE (permission "Email Routing Rules: Edit", limitable au seul domaine
# boulangerie-lomoto.com). Un jeton scopé uniquement à la seconde ne suffit
# pas : voir apps/api/src/lib/cloudflareEmail.ts. Tant que ces variables sont
# vides, le bouton "Créer l'adresse pro" reste visible mais échoue avec un
# message clair — aucune autre fonctionnalité n'est affectée.
CLOUDFLARE_API_TOKEN=""
# Tableau de bord Cloudflare → domaine → aperçu, colonne de droite ("Zone ID").
CLOUDFLARE_ZONE_ID=""
# Même page, juste en dessous ("Account ID") — portée différente du Zone ID,
# requise pour les adresses de destination (voir commentaire ci-dessus).
CLOUDFLARE_ACCOUNT_ID=""

# Sauvegarde automatique de la base (section 3.15) — écrite localement sur le
# disque du serveur (pas d'envoi vers un service externe : un compte de service
# Google Cloud a été essayé puis abandonné, les comptes de service n'ayant pas
# de quota de stockage propre sur Google Drive). Complète le téléchargement
# manuel pour copie sur clé USB/disque externe.
# Surcharges facultatives :
# BACKUP_CRON="30 2 * * *"
# BACKUP_TIMEZONE="Africa/Kinshasa"
# Répertoire de stockage local (utile si l'hébergeur propose un disque
# persistant, ex. Render Persistent Disk monté sur /data) :
# BACKUP_LOCAL_DIR="/data/sauvegardes"
# Nombre de sauvegardes locales conservées avant purge des plus anciennes :
# BACKUP_LOCAL_RETENTION="14"
# Chemin de pg_dump si l'hôte ne le met pas dans le PATH :
# PG_DUMP_PATH="/usr/bin/pg_dump"

# Balayage périodique des alertes (dette, absence en attente, seuil de stock —
# section 3.2/3.4/3.18, Lot 7 pt 2) : filet de sécurité en plus du déclenchement
# au chargement des écrans concernés. Réutilise BACKUP_TIMEZONE.
# Surcharge facultative :
# ALERTES_CRON="*/30 * * * *"
